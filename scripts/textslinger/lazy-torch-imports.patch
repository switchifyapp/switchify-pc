+# The byte and subword models need PyTorch and Transformers. They are imported
+# on first use so the n-gram and PPM models can be used without either.
+_LAZY_EXPORTS = {
+    "CausalByteLanguageModel": "causal_byte",
+    "DEFAULT_BYTE_WORD_ENDING_CHARACTERS": "causal_byte",
+    "ConfigPredictWordsByte": "causal_byte",
+    "ConfigPredictCharactersByte": "causal_byte",
+    "ConfigScoreItemsByte": "causal_byte",
+    "CausalSubwordLanguageModel": "causal_subword",
+    "DEFAULT_SUBWORD_WORD_ENDING_CHARACTERS": "causal_subword",
+    "ConfigPredictWordsSubword": "causal_subword",
+    "ConfigPredictCharactersSubword": "causal_subword",
+    "ConfigScoreItemsSubword": "causal_subword",
+    "CompilationPreparation": "compilation",
+    "prepare_compilation": "compilation",
+}
+
+if TYPE_CHECKING:
+    from .causal_byte import (
+        CausalByteLanguageModel,
+        DEFAULT_BYTE_WORD_ENDING_CHARACTERS,
+        ConfigPredictWordsByte,
+        ConfigPredictCharactersByte,
+        ConfigScoreItemsByte,
+    )
+    from .causal_subword import (
+        CausalSubwordLanguageModel,
+        DEFAULT_SUBWORD_WORD_ENDING_CHARACTERS,
+        ConfigPredictWordsSubword,
+        ConfigPredictCharactersSubword,
+        ConfigScoreItemsSubword,
+    )
+    from .compilation import CompilationPreparation, prepare_compilation
+
+
+def __getattr__(name):
+    module_name = _LAZY_EXPORTS.get(name)
+    if module_name is None:
+        raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+    value = getattr(import_module(f".{module_name}", __name__), name)
+    globals()[name] = value
+    return value
+
+
+def __dir__():
+    return sorted(set(globals()) | set(_LAZY_EXPORTS))
+
 __all__ = [
     "compilation_diagnostics",
