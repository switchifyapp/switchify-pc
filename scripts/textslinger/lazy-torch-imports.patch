+def __getattr__(name: str) -> Any:
+    # PRECISION_TO_TORCH stays importable without importing PyTorch at module
+    # load, so the n-gram and PPM models work without PyTorch installed.
+    if name == "PRECISION_TO_TORCH":
+        return _precision_to_torch()
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 
