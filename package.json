{
  "name": "switchify-pc",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prediction-model": "node scripts/fetch-prediction-model.mjs && node scripts/fetch-prediction-neural.mjs && node scripts/fetch-find-model.mjs",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "lint": "tsc --noEmit",
    "macos:setup-signing": "./scripts/setup-macos-dev-signing.sh",
    "macos:run": "./scripts/run-macos-signed.sh",
    "windows:package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Build-WindowsUiAccess.ps1",
    "windows:verify-package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/Verify-WindowsUiAccessPackage.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.65.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "0.8.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
