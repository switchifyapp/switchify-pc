{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchify PC",
  "version": "1.0.0-rc.15",
  "identifier": "com.enaboapps.switchify.pc",
  "build": {
    "beforeDevCommand": "npm run prediction-model && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prediction-model && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Switchify PC",
        "width": 920,
        "height": 700,
        "minWidth": 620,
        "minHeight": 520,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": ""
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "resources": [
      "resources/prediction-model/model.onnx",
      "resources/prediction-model/tokenizer.json",
      "resources/prediction-model/config.json"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Mobile control for Windows and macOS",
    "longDescription": "Cross-platform Switchify desktop companion for mobile control.",
    "windows": {
      "nsis": { "installMode": "perMachine" }
    },
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.3",
      "infoPlist": "Info.plist"
    }
  }
}
